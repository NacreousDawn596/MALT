# Common macOS/Linux ignore rules
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Nix build artifacts
result
result-*

# Packaging artifacts (never committed)
*.deb
*.rpm
*.exe
*.msi

# Test artifacts (must never leak into the repo root)
test_plot.png
*.png

# Application assets are committed intentionally.
!assets/logo.png

# Machine-specific benchmark results (never committed as universal guarantees)
benchmarks/results/*.txt
benchmarks/results/*.json

# Editor
.idea/
.vscode/
*.swp

node_modules/

dist/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example

!page/public/
!page/public/assets/
!page/public/assets/**